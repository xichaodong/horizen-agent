# 复制为仓库根目录 .env.yml；普通启动自动加载，demo 入口跳过本地配置。
# 默认使用无凭据脚本模型，外部集成默认关闭。启用前填写对应字段。
# 配置键使用小写层级结构；凭据只填写到 .env.yml，不提交到 Git。
spring:
  servlet:
    multipart:
      # 默认跟随 artifact.bos.max-object-bytes；调整容量时同步调整请求上限。
      max-file-size: '${horizen.agent.artifact.bos.max-object-bytes:104857600}B'
      max-request-size: 105MB

server:
  address: 127.0.0.1
  port: 8787
  tomcat:
    # 限制拒绝后读取的正文容量，并让超限请求稳定收到 413。
    max-swallow-size: '${spring.servlet.multipart.max-request-size:105MB}'

horizen:
  trace:
    enabled: false # 启用前填写 base-url、正整数 project-id 和服务凭据。
    base-url: '' # 例如 https://trace-service.example。
    project-id: 0
    token: ''
    capture-content: false # 是否上报消息和工具正文；默认仅记录元数据。
    source: horizen-agent-web
    agent-name: horizen-web-agent
    executor-name: horizen-agent-web
    environment: local
    request-timeout: 3s
    flush-interval: 1s
    queue-capacity: 2048
    shutdown-timeout: 3s
    max-retries: 2
    retry-initial-delay: 100ms
    retry-max-delay: 1s
  agent:
    model-mode: scripted # scripted / remote
    api-key: '' # remote 必填；填写服务商提供的访问凭据。
    base-url: 'https://your-model-provider.example/v1' # OpenAI-compatible API 基础地址。
    model-name: scripted-web # remote 时替换为服务商提供的模型标识。
    max-iters: 10
    stream-timeout: 10m # 单次执行最长持续时间。
    idle-timeout: 2m # 没有新事件时允许的最长空闲时间。
    # 图片由独立视觉模型处理，主模型只接收文字和工具结果。
    vision:
      enabled: false # 启用前显式填写支持图片输入的 model-name。
      model-name: '' # 不回退到主模型，例如填写服务商提供的视觉模型标识。
      base-url: '' # 可独立指定服务地址；留空复用主模型 base-url。
      api-key: '' # 同服务商时可留空复用主模型凭据；换服务商须独立填写，不提交真实 Key。
    multimodal:
      max-images-per-turn: 5
      max-image-bytes: 10485760
      max-total-image-bytes: 20971520
      image-url-expires-seconds: 3600
    # 压缩模型留空时使用主模型；按实际模型容量设置上下文窗口。
    context:
      model-context-window-tokens: 0 # 0 表示使用运行时默认估算。
      compression-model-name: ''
      compression-model-base-url: ''
      compression-model-api-key: ''

    storage:
      mode: local # local / distributed
      jdbc-url: '' # 例如 jdbc:mysql://127.0.0.1:3306/horizen_agent?serverTimezone=UTC
      jdbc-username: ''
      jdbc-password: ''
      jdbc-maximum-pool-size: 10
      redis-url: '' # 例如 redis://127.0.0.1:6379；认证时使用服务端凭据。
      redis-maximum-pool-size: 8
      redis-key-prefix: 'horizen-agent:'
      instance-id: '' # 多实例部署时，每个实例使用不同且稳定的标识。
      event-ttl: 15m
      session-state-ttl: 24h # 必须大于 30m 且覆盖 stream-timeout。
      lease-ttl: 30s
      lease-heartbeat: 10s
      control-poll-interval: 500ms
      lease-renewal:
        batch-size: 50
        concurrency: 2
        retries: 1
        retry-delay: 1s
        query-timeout: 3s
        connection-acquire-timeout: 3s

    gateway:
      mode: remote # remote / mock；mock 需要可读取的合成 fixture 文件。
      url: '' # 例如 https://tool-provider.example；按 Provider 协议配置。
      token: '' # 服务端 Bearer 凭据；不要写入模板或提交 Git。
      timeout: 30s
      allowed-tools: [ ] # 空列表使用网关目录；非空时取名称交集。
      fixture-file: .agentscope/web-workspace/mock-gateway.json

    artifact:
      bos:
        enabled: false
        endpoint: '' # 例如 https://bj.bcebos.com；以实际桶地域为准。
        bucket: ''
        access-key: ''
        secret-key: ''
        key-prefix: agentFiles/horizen-artifacts
        max-object-bytes: 104857600

    sandbox:
      e2b:
        enabled: false
        api-key: ''
        api-base-url: 'https://api.agent-sandbox.example'
        runtime-base-url-pattern: 'https://49983-{sandbox_id}.agent-sandbox.example'
        template-id: ''
        workspace-root: /tmp/horizen-agent
        isolation-scope: session # session / user；按隔离需求选择。
        sandbox-timeout-seconds: 300
        connect-timeout-seconds: 30
        read-timeout-seconds: 120
        max-output-bytes: 524288
      # 跨沙箱恢复任务文件需要快照存储；BOS 凭据可复用 artifact.bos 配置。
      snapshot:
        bos:
          enabled: false
          key-prefix: agentFiles/horizen-sandbox-snapshots
          max-archive-bytes: 67108864
          max-entries: 10000
          concurrency: 2
          timeout-seconds: 120

    workspace-release:
      enabled: false
      source: remote # remote：远端发布服务；local：本 Agent 的管理数据。
      endpoint: '' # remote 必填，例如 https://workspace.example/horizen/api/internal/agent-workspaces/v1/releases/current
      project-id: 0 # 启用时填写正整数 Project 标识。
      agent-key: horizen-web-agent # 必须与宿主 Agent 标识一致。
      token: '' # 远端发布服务的机器访问凭据。
      artifact-hosts: [ ] # remote 必填：允许下载发布制品的主机名，不含协议和路径。
      allow-http: false
      request-timeout: 15s
      cache-directory: .agentscope/agent-publications
      max-cache-bytes: 1073741824
      max-concurrent-executions: 8
    workspace-management:
      enabled: false # 管理 API 和运行时发布读取分别控制。
      token: '' # 管理 API 使用独立的服务凭据。
      project-ids: [ ] # 可访问的 Project 标识列表。
    workspace-storage:
      # BOS 连接信息默认复用 artifact.bos 配置；无需重复填写。
      key-prefix: agentFiles/horizen-workspace-files
      max-file-bytes: 10485760

    skill-release:
      enabled: false
