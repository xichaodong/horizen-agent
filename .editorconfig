root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120
ij_continuation_indent_size = 8

[*.{md,json,yml,yaml}]
indent_size = 2

[.env.yml.example]
indent_size = 2

[*.{js,jsx,less,html,xml}]
ij_continuation_indent_size = 4
